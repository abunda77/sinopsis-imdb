# API Configuration for LLM Service
# Copy this file to .env and fill in your actual values

# Your API key for the LLM service (required)
VITE_API_KEY=your-api-key-here

# The model name to use for LLM requests (required)
# Examples: gpt-4, gpt-3.5-turbo, sonar (Perplexity), claude-3-opus, etc.
VITE_MODEL_NAME=gpt-4

# Base URL for the API endpoint (optional - not used in current version)
# The app now uses proxy server for all API requests
# This variable is kept for backward compatibility but can be omitted
# VITE_API_BASE_URL=https://api.openai.com/v1

