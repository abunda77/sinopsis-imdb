# API Configuration for LLM Service
# Copy this file to .env and fill in your actual values

# ==========================================
# Server-side secret (NEVER expose to the browser)
# ==========================================
# Read only by server.js. Do not add a VITE_ prefix to this variable:
# Vite inlines VITE_* values into the public browser bundle.
# OpenRouter keys start with "sk-or-v1-..."
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ==========================================
# Client-visible configuration (no secrets here)
# ==========================================
# The model name to use for LLM requests (required by the client).
# This is not a secret: it is served in dist/config.js.
# Examples (OpenRouter):
# - perplexity/sonar, perplexity/sonar-pro
# - openai/gpt-4o, anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-001
VITE_MODEL_NAME=perplexity/sonar

# Port for the production server (optional)
PORT=3200

# LLM API Target for Production Server (optional)
# This is used by server.js to proxy requests
# Examples:
# - OpenRouter: https://openrouter.ai/api/v1/chat/completions
# - Perplexity: https://api.perplexity.ai/chat/completions
# - OpenAI: https://api.openai.com/v1/chat/completions
LLM_API_TARGET=https://openrouter.ai/api/v1/chat/completions

# Vite Dev Proxy Target (optional)
# In development, Vite forwards /api to the local Express server (which holds the
# key). Defaults to http://localhost:$PORT. Override only if the backend runs
# elsewhere.
# VITE_DEV_PROXY_TARGET=http://localhost:3200
