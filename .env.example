# API Configuration for LLM Service
# Copy this file to .env and fill in your actual values

# Your API key for the LLM service (required)
# OpenRouter keys start with "sk-or-v1-..."
VITE_API_KEY=sk-or-v1-your-openrouter-key-here

# Server-side API key used by server.js (optional).
# When set, the proxy uses this key instead of whatever the browser sends,
# so production keeps working even if the built runtime config is stale.
# Leave unset to reuse VITE_API_KEY.
# OPENROUTER_API_KEY=

# The model name to use for LLM requests (required)
# Examples (OpenRouter):
# - perplexity/sonar, perplexity/sonar-pro
# - openai/gpt-4o, anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-001
VITE_MODEL_NAME=perplexity/sonar

# Base URL for the API endpoint (optional)
VITE_API_BASE_URL=https://openrouter.ai/api/v1

# Port for the production server (optional)
PORT=3200

# LLM API Target for Production Server (optional)
# This is used by server.js to proxy requests
# Examples:
# - OpenRouter: https://openrouter.ai/api/v1/chat/completions
# - Perplexity: https://api.perplexity.ai/chat/completions
# - OpenAI: https://api.openai.com/v1/chat/completions
LLM_API_TARGET=https://openrouter.ai/api/v1/chat/completions

# Vite Dev Proxy Target (optional)
# This is used by vite.config.ts for development proxy
# Examples:
# - OpenRouter: https://openrouter.ai/api
# - Perplexity: https://api.perplexity.ai
VITE_PROXY_TARGET=https://openrouter.ai/api
