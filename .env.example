# API Configuration for LLM Service
# Copy this file to .env and fill in your actual values

# Your API key for the LLM service (required)
VITE_API_KEY=your-api-key-here

# The model name to use for LLM requests (required)
# Examples: gpt-4, gpt-3.5-turbo, claude-3-opus, etc.
VITE_MODEL_NAME=gpt-4

# Base URL for the API endpoint (optional)
# Default: https://api.openai.com/v1
# For other providers, use their base URL (e.g., https://api.anthropic.com/v1)
VITE_API_BASE_URL=https://api.openai.com/v1
